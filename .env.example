# Private key for deploying contracts to Sepolia/Base Sepolia
# NEVER commit this file to git! It's in .gitignore.
# Get your private key from MetaMask: Account Details > Export Private Key
SEPOLIA_PRIVATE_KEY=your_wallet_private_key_here

# PostgreSQL connection string
# Create a free database at https://neon.tech and paste the connection string here
DATABASE_URL="postgresql://user:password@your-neon-host.neon.tech/neondb?sslmode=require&connect_timeout=30"
